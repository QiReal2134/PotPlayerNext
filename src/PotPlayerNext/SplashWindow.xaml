<Window x:Class="PotPlayerNext.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:PotPlayerNext.Controls" Title="PotPlayerNext">
    <Grid x:Name="Root" UseLayoutRounding="True">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
            <controls:BrandLogo x:Name="Logo" Width="164" Height="164" Opacity="0" />
            <TextBlock Text="qireal" FontSize="14" HorizontalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </Grid>
</Window>
