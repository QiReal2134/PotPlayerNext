<Window x:Class="PotPlayerNext.PreviewWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:services="using:PotPlayerNext.Services" Title="预览">
 <services:PreviewSurface x:Name="Root" Background="Transparent" UseLayoutRounding="True">
  <services:PreviewSurface.ContextFlyout><MenuFlyout>
   <ToggleMenuFlyoutItem x:Name="TransportToggle" Text="显示播放控件" Click="TransportToggle_Click"/>
   <MenuFlyoutItem Text="适应窗口" Click="Fit_Click"/>
   <MenuFlyoutItem Text="外部打开…" Click="External_Click"/>
   <MenuFlyoutSeparator/><MenuFlyoutItem Text="关闭" Click="Close_Click"/>
  </MenuFlyout></services:PreviewSurface.ContextFlyout>
  <ScrollViewer x:Name="ImageScroll" IsTabStop="True" ZoomMode="Enabled" MinZoomFactor="0.1" MaxZoomFactor="8"
   HorizontalScrollMode="Enabled" VerticalScrollMode="Enabled"
   HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
   <Grid x:Name="MediaSurface" Width="1" Height="1" Background="Transparent">
    <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></Grid.ChildrenTransitions>
    <Image x:Name="Picture" Stretch="Uniform"/>
    <MediaPlayerElement x:Name="Video" IsTabStop="True" Visibility="Collapsed" Stretch="Uniform" AreTransportControlsEnabled="False"/>
   </Grid>
  </ScrollViewer>
 </services:PreviewSurface>
</Window>
