<Window x:Class="PotPlayerNext.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:PotPlayerNext.Controls" Title="PotPlayerNext">
 <Grid x:Name="Root" Background="Transparent" UseLayoutRounding="True" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid.ChildrenTransitions><TransitionCollection><EntranceThemeTransition IsStaggeringEnabled="False"/></TransitionCollection></Grid.ChildrenTransitions>
  <Grid Padding="24,16,144,8" ColumnSpacing="16">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Grid x:Name="TitleDragRegion"><StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <controls:BrandLogo Width="28" Height="28"/>
    <TextBlock Text="PotPlayerNext" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel></Grid>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
    <Button Content="打开文件" Click="OpenFile_Click"/><Button Content="打开文件夹" Click="OpenFolder_Click" Style="{StaticResource AccentButtonStyle}"/>
    <Button AutomationProperties.Name="播放设置" ToolTipService.ToolTip="播放设置">
     <FontIcon Glyph="&#xE713;" FontSize="16"/>
     <Button.Flyout><Flyout Opened="Settings_Opened"><StackPanel Width="272" Spacing="16">
      <TextBlock Text="播放与预览" FontSize="18" FontWeight="SemiBold"/>
      <NumberBox x:Name="SeekStep" Header="快进 / 倒退步长（秒）" Minimum="0.1" Maximum="120" SmallChange="0.5" LargeChange="5" SpinButtonPlacementMode="Inline" ValueChanged="SeekStep_ValueChanged"/>
      <ToggleSwitch x:Name="HoldSpeed" Header="长按 → / D 临时 2 倍速" Toggled="PlaybackSetting_Toggled"/>
      <ToggleSwitch x:Name="PreviewProgress" Header="预览显示播放控件" Toggled="PlaybackSetting_Toggled"/>
      <ToggleSwitch x:Name="ExplorerPreview" Header="资源管理器空格预览" Toggled="ExplorerPreview_Toggled"/>
      <Button Content="设为默认图片 / 视频应用" Click="DefaultApps_Click" HorizontalAlignment="Stretch"/>
      <TextBlock Text="轻按 → / D 快进，← / A 倒退。&#xA;长按超过 250ms 加速，松开恢复。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/>
     </StackPanel></Flyout></Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1" Padding="24,8,24,16" ColumnSpacing="10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="200"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <TextBox x:Name="FolderLabel" PlaceholderText="文件或文件夹路径 · Enter 打开" KeyDown="FolderPath_KeyDown" AutomationProperties.Name="媒体路径"/>
   <TextBox x:Name="Search" Grid.Column="1" PlaceholderText="搜索" TextChanged="Filter_Changed"/>
   <ComboBox x:Name="KindFilter" Grid.Column="2" SelectedIndex="0" SelectionChanged="KindFilter_Changed" HorizontalAlignment="Stretch">
    <ComboBoxItem Content="全部媒体"/><ComboBoxItem Content="图片"/><ComboBoxItem Content="视频"/>
   </ComboBox>
  </Grid>
  <InfoBar x:Name="Notice" Grid.Row="2" Margin="24,0,24,12" IsOpen="False" IsClosable="True" Title="PotPlayerNext"/>
  <Grid Grid.Row="3" Margin="20,0">
   <ListView x:Name="MediaList" SelectionMode="Single" HorizontalContentAlignment="Stretch" IsItemClickEnabled="False" DoubleTapped="MediaList_DoubleTapped" ContainerContentChanging="MediaList_ContainerContentChanging">
    <ListView.ItemTemplate><DataTemplate>
     <Border Padding="10" Margin="0,2" CornerRadius="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
      <Grid ColumnSpacing="16" Height="76">
       <Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border CornerRadius="6" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="&#xEB9F;" FontSize="24" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/><Image Stretch="Uniform"/></Grid></Border>
       <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"/></StackPanel>
      </Grid>
     </Border>
    </DataTemplate></ListView.ItemTemplate>
   </ListView>
   <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
    <FontIcon Glyph="&#xE8B9;" FontSize="42" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
    <TextBlock x:Name="EmptyTitle" Text="打开你的媒体" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock x:Name="EmptyHint" Text="拖入文件，或打开文件夹。空格即可预览。" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center"/>
   </StackPanel>
   <ProgressRing x:Name="Loading" IsActive="False" Visibility="Collapsed" Width="40" Height="40"/>
  </Grid>
  <Grid Grid.Row="4" Padding="24,12" ColumnSpacing="12">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="Status" Text="就绪" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
   <TextBlock Grid.Column="1" Text="Space 预览 · Esc 关闭" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
  </Grid>
 </Grid>
</Window>
